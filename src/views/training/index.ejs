<!DOCTYPE html>
<html>
<head><title>Training &amp; Resources - Booking Admin</title><%- include('../partials/head') %></head>
<body>
<div class="app-shell">
  <%- include('../partials/sidebar') %>
  <div class="main">
    <%
      const ICONS = {
        cocktail: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16l-8 9-8-9Z"/><path d="M12 13v7"/><path d="M8 20h8"/></svg>',
        spirit: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2h6v3.5l1.5 2.5V21a1 1 0 0 1-1 1H8.5a1 1 0 0 1-1-1V8l1.5-2.5V2Z"/><path d="M9 12h6"/></svg>',
        beer: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h11v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V8Z"/><path d="M16 10h2a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-2"/><path d="M5 8V5a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v3"/></svg>',
        recipe: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3v7a2 2 0 0 0 2 2v9"/><path d="M7 3v4M9 3v4M11 3v4"/><path d="M17 3c-2 0-3 2-3 5s1 4 3 4v9"/></svg>',
        prep: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="10" width="13" height="9" rx="1.5"/><path d="m17 4 3 3-8.5 8.5-3.3.8.8-3.3L17 4Z"/></svg>',
        cleaning: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2h4l1 3H8l1-3Z"/><path d="M8 5h6l1.5 2H16a1 1 0 0 1 1 1v12a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V8a1 1 0 0 1 1-1h0Z"/><path d="M9.5 12h5M9.5 15h5"/></svg>'
      };
      const TUTORIAL_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M10 8.3v7.4l6-3.7-6-3.7Z" fill="currentColor" stroke="none"/></svg>';
      const ACCENTS = {
        cocktail: '#b3492f', spirit: '#a9762b', beer: '#c98a1f',
        recipe: '#2f6b4f', prep: '#2b6e8a', cleaning: '#3f8f8a'
      };
      const SECTION_TITLES = { bar: 'Behind the Bar', kitchen: 'In the Kitchen' };
    %>
    <div class="training-hero">
      <h2>Training &amp; Resources</h2>
      <p>Recipes, techniques, and tutorials curated by Managers — browse whenever you want a refresher, or before trying something new.</p>
    </div>

    <% sections.forEach((section, sIdx) => { %>
      <div class="training-section" style="<%= sIdx > 0 ? 'margin-top:32px' : '' %>">
        <div class="training-section-head">
          <h3><%= SECTION_TITLES[section.key] || section.label %></h3>
          <p class="muted"><%= section.blurb %></p>
        </div>
        <div class="training-columns">
          <% section.categories.forEach(catValue => {
               const cat = categories.find(c => c.value === catValue);
               if (!cat) return;
          %>
            <div class="training-column" style="--col-accent: <%= ACCENTS[cat.value] %>">
              <div class="training-column-head">
                <span class="training-column-icon"><%- ICONS[cat.value] %></span>
                <div>
                  <div class="training-column-title"><%= cat.label %></div>
                  <div class="training-column-count"><%= grouped[cat.value].length %> on file</div>
                </div>
                <% if (canEdit) { %>
                  <span class="training-column-add"><a href="/training/new?category=<%= cat.value %>" title="Add <%= cat.labelSingular.toLowerCase() %>">+</a></span>
                <% } %>
              </div>

              <% if (!grouped[cat.value].length) { %>
                <div class="training-empty">
                  Nothing here yet.
                  <% if (canEdit) { %><br><a href="/training/new?category=<%= cat.value %>">Add the first <%= cat.labelSingular.toLowerCase() %></a><% } %>
                </div>
              <% } else { %>
                <div class="training-card-list">
                  <% grouped[cat.value].forEach(item => { %>
                    <a class="training-card" href="/training/<%= item.id %>">
                      <span class="training-card-thumb">
                        <% if (item.photoPath) { %>
                          <img src="<%= item.photoPath %>" alt="">
                        <% } else { %>
                          <%- ICONS[cat.value] %>
                        <% } %>
                      </span>
                      <span class="training-card-body">
                        <span class="training-card-name"><%= item.name %></span>
                        <% if (item.subtitle) { %><span class="training-card-subtitle"><%= item.subtitle %></span><% } %>
                        <% if (item.videoPath || item.youtubeId) { %>
                          <span class="training-tutorial-tag"><%- TUTORIAL_ICON %> Watch tutorial</span>
                        <% } %>
                      </span>
                    </a>
                  <% }) %>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </div>
</div>
</body>
</html>
