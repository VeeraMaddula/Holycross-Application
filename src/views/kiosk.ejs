<!DOCTYPE html>
<html>
<head><title>Staff Clock In / Out - The Holy Cross</title><%- include('partials/head') %></head>
<body>
<div class="kiosk-shell">
  <div class="kiosk-header">
    <div>
      <img src="/img/logo.jpeg" alt="The Holy Cross" class="kiosk-logo">
      <div class="kiosk-title">
        <div class="kiosk-brand">The Holy Cross</div>
        <div class="kiosk-sub">Tap your photo to clock in or out</div>
      </div>
    </div>
    <div class="kiosk-header-right">
      <div class="kiosk-clock" id="kioskClock"></div>
      <% if (currentUser && currentUser.role === 'kiosk') { %>
        <form method="POST" action="/logout" onsubmit="return confirm('Log the Bot account out of this tablet?')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="kiosk-exit">Exit</button>
        </form>
      <% } else if (currentUser) { %>
        <a href="/" class="kiosk-exit">Exit kiosk</a>
      <% } %>
    </div>
  </div>

  <div class="kiosk-grid" id="kioskGrid">
    <% staff.forEach(s => { %>
      <div class="kiosk-tile" data-user-id="<%= s.id %>" data-user-name="<%= s.name %>" data-color="<%= s.color %>" data-live-status="<%= s.status %>" data-since="<%= s.since || '' %>">
        <% if (s.avatarPath) { %>
          <img class="kiosk-tile-avatar" data-path="<%= s.avatarPath %>" src="<%= s.avatarPath %>" alt="<%= s.name %>">
        <% } else { %>
          <div class="kiosk-tile-avatar kiosk-tile-initials" data-path="" style="background:<%= s.color %>">
            <%= s.name.split(' ').map(p => p[0]).join('').toUpperCase() %>
          </div>
        <% } %>
        <div class="kiosk-tile-name"><%= s.name %></div>
        <span class="badge kiosk-status-badge <%= 'kiosk-status-' + s.status %>" data-status><%=
          s.status === 'clocked_in' ? 'Present' : (s.status === 'on_break' ? 'On break' : 'Clocked out')
        %></span>
        <div class="kiosk-tile-timer"></div>
      </div>
    <% }) %>
  </div>
  <% if (!staff.length) { %>
    <p class="muted" style="text-align:center">No staff accounts yet — add staff on the Users page.</p>
  <% } %>
</div>

<!-- Bar Staff Duties: an ambient corner tab + side panel, separate from the
     PIN-gated clock pad above. Only appears during a scheduled duties
     window (Opening/After Breakfast/After Carvery/Closing) and never
     blocks the tile grid — other staff can keep clocking in/out underneath
     it the whole time. -->
<div class="kiosk-duties-tab" id="dutiesTab">
  <span id="dutiesTabTitle"></span>
  <span class="kiosk-duties-tab-count" id="dutiesTabCount"></span>
</div>

<div class="kiosk-duties-panel" id="dutiesPanel">
  <div class="kiosk-duties-panel-header">
    <span id="dutiesPanelTitle"></span>
    <button type="button" class="kiosk-duties-collapse" id="dutiesCollapseBtn" aria-label="Collapse">&times;</button>
  </div>
  <div class="kiosk-duties-panel-body" id="dutiesPanelBody"></div>
  <div class="kiosk-duties-panel-footer" id="dutiesPanelFooter">
    <button type="button" class="btn" id="dutiesSubmitBtn">Submit</button>
  </div>
  <div class="kiosk-duties-reason" id="dutiesWhoBox" style="display:none">
    <p class="muted" style="margin:0 0 8px">Who's submitting this?</p>
    <select id="dutiesWhoSelect"></select>
    <div class="kiosk-duties-reason-actions">
      <button type="button" class="btn secondary" id="dutiesWhoCancel">Back</button>
      <button type="button" class="btn" id="dutiesWhoContinue">Continue</button>
    </div>
  </div>
  <div class="kiosk-duties-reason" id="dutiesCameraBox" style="display:none">
    <video id="dutiesCameraVideo" autoplay playsinline muted class="kiosk-camera-video"></video>
    <canvas id="dutiesCameraCanvas" style="display:none"></canvas>
    <p class="muted" id="dutiesCameraStatus" style="margin:10px 0">Starting camera&hellip;</p>
    <div class="kiosk-action-buttons">
      <button type="button" class="kiosk-action-btn kiosk-btn-in" id="dutiesCaptureBtn" disabled>Take photo</button>
    </div>
    <button type="button" class="btn secondary" id="dutiesCameraCancel">Cancel</button>
  </div>
  <div class="kiosk-duties-reason" id="dutiesReasonBox" style="display:none">
    <p class="muted" style="margin:0 0 8px">Some duties aren't ticked — why? This will be sent to the managers.</p>
    <textarea id="dutiesReasonText" rows="3" placeholder="e.g. Short-staffed this morning, will finish by 9:15"></textarea>
    <div class="kiosk-duties-reason-actions">
      <button type="button" class="btn secondary" id="dutiesReasonCancel">Back</button>
      <button type="button" class="btn" id="dutiesReasonSend">Send report</button>
    </div>
  </div>
  <div class="kiosk-duties-done" id="dutiesDoneMsg" style="display:none">
    <div class="kiosk-success-check">&#10003;</div>
    <p>Thanks — submitted.</p>
  </div>
</div>

<div class="kiosk-modal-overlay" id="kioskModal">
  <div class="kiosk-modal">

    <div id="kioskPinStage">
      <div class="kiosk-modal-avatar" id="pinAvatar"></div>
      <div class="kiosk-modal-name" id="pinName"></div>
      <div class="muted" style="margin-bottom:16px">Enter your 4-digit PIN</div>
      <div class="kiosk-pin-dots" id="pinDots"></div>
      <div class="kiosk-pin-error" id="pinError"></div>
      <div class="kiosk-keypad" id="pinPad"></div>
      <button type="button" class="btn secondary" id="pinCancel">Cancel</button>
      <button type="button" class="kiosk-forgot-pin" id="forgotPinBtn">Forgot PIN?</button>
    </div>

    <div id="kioskActionStage" style="display:none">
      <div class="kiosk-modal-avatar" id="actionAvatar"></div>
      <div class="kiosk-modal-name" id="actionName"></div>
      <span class="badge" id="actionBadge" style="margin-bottom:18px"></span>
      <div class="kiosk-action-buttons" id="actionButtons"></div>
      <button type="button" class="btn secondary" id="actionCancel">Cancel</button>
    </div>

    <div id="kioskCameraStage" style="display:none">
      <div class="kiosk-modal-name" id="cameraName" style="margin-bottom:10px"></div>
      <video id="kioskCameraVideo" autoplay playsinline muted class="kiosk-camera-video"></video>
      <canvas id="kioskCameraCanvas" style="display:none"></canvas>
      <p class="muted" id="kioskCameraStatus" style="margin:10px 0">Starting camera…</p>
      <div class="kiosk-action-buttons">
        <button type="button" class="kiosk-action-btn kiosk-btn-in" id="kioskCaptureBtn" disabled>Take photo &amp; clock in</button>
      </div>
      <button type="button" class="btn secondary" id="cameraCancel">Cancel</button>
    </div>

    <div id="kioskSuccessStage" style="display:none">
      <div class="kiosk-success-check">&#10003;</div>
      <div class="kiosk-modal-name" id="successText"></div>
    </div>

  </div>
</div>

<script>
(function() {
  var ACTION_META = {
    clock_in: { label: 'Clock in', cls: 'kiosk-btn-in', camera: true },
    clock_out: { label: 'Clock out', cls: 'kiosk-btn-out', camera: false },
    break_start: { label: 'Start break', cls: 'kiosk-btn-break', camera: true },
    break_end: { label: 'End break', cls: 'kiosk-btn-in', camera: true }
  };
  var STATUS_LABEL = { clocked_out: 'Clocked out', clocked_in: 'Present', on_break: 'On break' };
  var NEXT_ACTIONS = {
    clocked_out: ['clock_in'],
    clocked_in: ['clock_out', 'break_start'],
    on_break: ['break_end']
  };

  var modal = document.getElementById('kioskModal');
  var pinStage = document.getElementById('kioskPinStage');
  var actionStage = document.getElementById('kioskActionStage');
  var successStage = document.getElementById('kioskSuccessStage');
  var pinDots = document.getElementById('pinDots');
  var pinError = document.getElementById('pinError');
  var pinPad = document.getElementById('pinPad');

  var activeUserId = null, activeName = null, activeColor = null, entered = '', pendingAction = null;

  function initials(name) { return name.split(' ').map(function(p) { return p[0]; }).join('').toUpperCase(); }

  function renderDots() {
    pinDots.innerHTML = '';
    for (var i = 0; i < 4; i++) {
      var d = document.createElement('span');
      d.className = 'kiosk-pin-dot' + (i < entered.length ? ' filled' : '');
      pinDots.appendChild(d);
    }
  }

  function renderPad() {
    pinPad.innerHTML = '';
    ['1','2','3','4','5','6','7','8','9','','0','del'].forEach(function(k) {
      var btn = document.createElement('button');
      btn.type = 'button';
      if (k === '') { btn.style.visibility = 'hidden'; pinPad.appendChild(btn); return; }
      btn.className = 'kiosk-key';
      btn.textContent = k === 'del' ? String.fromCharCode(9003) : k;
      btn.addEventListener('click', function() { pressKey(k); });
      pinPad.appendChild(btn);
    });
  }

  function pressKey(k) {
    if (k === 'del') { entered = entered.slice(0, -1); renderDots(); return; }
    if (entered.length >= 4) return;
    entered += k;
    renderDots();
    if (entered.length === 4) setTimeout(verifyPin, 150);
  }

  var cameraStage = document.getElementById('kioskCameraStage');
  var cameraVideo = document.getElementById('kioskCameraVideo');
  var cameraCanvas = document.getElementById('kioskCameraCanvas');
  var cameraStatus = document.getElementById('kioskCameraStatus');
  var captureBtn = document.getElementById('kioskCaptureBtn');
  var cameraStream = null;

  function openModal(id, name, color) {
    activeUserId = id; activeName = name; activeColor = color; entered = '';
    document.getElementById('pinAvatar').textContent = initials(name);
    document.getElementById('pinAvatar').style.background = color;
    document.getElementById('pinName').textContent = name;
    pinError.textContent = '';
    renderDots();
    renderPad();
    pinStage.style.display = 'block';
    actionStage.style.display = 'none';
    cameraStage.style.display = 'none';
    successStage.style.display = 'none';
    modal.classList.add('open');
  }

  function stopCamera() {
    if (cameraStream) {
      cameraStream.getTracks().forEach(function(t) { t.stop(); });
      cameraStream = null;
    }
  }

  function closeModal() {
    modal.classList.remove('open');
    activeUserId = null;
    stopCamera();
  }
  document.getElementById('pinCancel').addEventListener('click', closeModal);
  document.getElementById('actionCancel').addEventListener('click', closeModal);
  document.getElementById('cameraCancel').addEventListener('click', closeModal);

  document.getElementById('forgotPinBtn').addEventListener('click', function() {
    var btn = this;
    if (!activeUserId) return;
    btn.disabled = true;
    btn.textContent = 'Notifying a manager…';
    fetch('/kiosk/forgot-pin', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
      body: JSON.stringify({ userId: activeUserId })
    }).then(function() {
      pinStage.style.display = 'none';
      successStage.style.display = 'block';
      document.getElementById('successText').textContent = 'A manager has been notified — ask them for your new PIN.';
      setTimeout(closeModal, 2200);
    }).catch(function() {
      pinError.textContent = 'Could not reach the server — check the connection.';
    }).finally(function() {
      btn.disabled = false;
      btn.textContent = 'Forgot PIN?';
    });
  });

  document.getElementById('kioskGrid').addEventListener('click', function(e) {
    var tile = e.target.closest('.kiosk-tile');
    if (!tile) return;
    openModal(tile.getAttribute('data-user-id'), tile.getAttribute('data-user-name'), tile.getAttribute('data-color'));
  });

  function verifyPin() {
    fetch('/kiosk/verify', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
      body: JSON.stringify({ userId: activeUserId, pin: entered })
    }).then(function(r) { return r.json().then(function(data) { return { ok: r.ok, data: data }; }); })
      .then(function(result) {
        if (!result.ok) {
          pinError.textContent = result.data.error || 'Something went wrong.';
          entered = '';
          renderDots();
          return;
        }
        showActions(result.data.status);
      }).catch(function() {
        pinError.textContent = 'Could not reach the server — check the connection.';
        entered = '';
        renderDots();
      });
  }

  function showActions(status) {
    pinStage.style.display = 'none';
    var actions = NEXT_ACTIONS[status] || [];
    // Clock in / start break / end break all capture a fresh photo, so when
    // there's only one possible next action and it needs a photo, skip
    // straight to the camera step. Clock out never needs a photo.
    if (actions.length === 1 && ACTION_META[actions[0]].camera) {
      pendingAction = actions[0];
      showCameraStage();
      return;
    }
    actionStage.style.display = 'block';
    document.getElementById('actionAvatar').textContent = initials(activeName);
    document.getElementById('actionAvatar').style.background = activeColor;
    document.getElementById('actionName').textContent = activeName;
    var badge = document.getElementById('actionBadge');
    badge.className = 'badge kiosk-status-badge kiosk-status-' + status;
    badge.textContent = STATUS_LABEL[status];
    var wrap = document.getElementById('actionButtons');
    wrap.innerHTML = '';
    actions.forEach(function(action) {
      var meta = ACTION_META[action];
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'kiosk-action-btn ' + meta.cls;
      b.textContent = meta.label;
      b.addEventListener('click', function() {
        if (meta.camera) { pendingAction = action; showCameraStage(); }
        else { doAction(action, null); }
      });
      wrap.appendChild(b);
    });
  }

  function showCameraStage() {
    actionStage.style.display = 'none';
    cameraStage.style.display = 'block';
    document.getElementById('cameraName').textContent = activeName;
    cameraStatus.textContent = 'Starting camera…';
    captureBtn.disabled = true;
    captureBtn.textContent = 'Take photo & ' + ACTION_META[pendingAction].label.toLowerCase();
    captureBtn.onclick = function() { captureAndSubmit(); };

    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      cameraStatus.textContent = 'Camera not supported on this device/browser.';
      return;
    }
    navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false })
      .then(function(stream) {
        cameraStream = stream;
        cameraVideo.srcObject = stream;
        cameraStatus.textContent = 'Look at the camera, then tap to continue.';
        captureBtn.disabled = false;
      })
      .catch(function(err) {
        cameraStatus.textContent = 'Could not access the camera: ' + err.message + '.';
      });
  }

  function captureAndSubmit() {
    if (!cameraStream) return;
    captureBtn.disabled = true;
    captureBtn.textContent = 'Saving…';
    cameraCanvas.width = cameraVideo.videoWidth || 480;
    cameraCanvas.height = cameraVideo.videoHeight || 480;
    cameraCanvas.getContext('2d').drawImage(cameraVideo, 0, 0, cameraCanvas.width, cameraCanvas.height);
    cameraCanvas.toBlob(function(blob) {
      doAction(pendingAction, blob);
    }, 'image/jpeg', 0.85);
  }

  function doAction(action, photoBlob) {
    var formData = new FormData();
    formData.append('userId', activeUserId);
    formData.append('pin', entered);
    formData.append('action', action);
    if (photoBlob) formData.append('photo', photoBlob, 'clockin.jpg');

    fetch('/kiosk/action', { method: 'POST', body: formData, headers: { Accept: 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' } })
      .then(function(r) { return r.json().then(function(data) { return { ok: r.ok, data: data }; }); })
      .then(function(result) {
        if (!result.ok) {
          showActionError(result.data.error || 'Something went wrong.');
          return;
        }
        actionStage.style.display = 'none';
        cameraStage.style.display = 'none';
        stopCamera();
        successStage.style.display = 'block';
        var label = action === 'clock_in' ? 'Clocked in' : action === 'clock_out' ? 'Clocked out' : action === 'break_start' ? 'Break started' : 'Break ended';
        document.getElementById('successText').textContent = label + ' — ' + activeName;
        // avatarPath is always present in the response — either a fresh
        // shift photo, or (on clock_out) the reverted saved profile picture,
        // which may be '' if the person never uploaded one.
        updateTileAvatar(activeUserId, result.data.avatarPath, activeColor, activeName);
        refreshTiles();
        setTimeout(closeModal, 1400);
      }).catch(function() {
        showActionError('Could not reach the server — check the connection.');
      });
  }

  function updateTileAvatar(userId, avatarPath, color, name) {
    var tile = document.querySelector('.kiosk-tile[data-user-id="' + userId + '"]');
    if (!tile) return;
    var oldAvatar = tile.querySelector('.kiosk-tile-avatar');
    var el;
    if (avatarPath) {
      el = document.createElement('img');
      el.className = 'kiosk-tile-avatar';
      el.alt = name;
      el.setAttribute('data-path', avatarPath);
      el.src = avatarPath + '?t=' + Date.now();
    } else {
      el = document.createElement('div');
      el.className = 'kiosk-tile-avatar kiosk-tile-initials';
      el.setAttribute('data-path', '');
      el.style.background = color;
      el.textContent = initials(name);
    }
    if (oldAvatar) oldAvatar.replaceWith(el);
  }

  function showActionError(message) {
    stopCamera();
    pinStage.style.display = 'block';
    actionStage.style.display = 'none';
    cameraStage.style.display = 'none';
    entered = '';
    pinError.textContent = message;
    renderDots();
  }

  function refreshTiles() {
    fetch('/kiosk/status').then(function(r) { return r.json(); }).then(function(list) {
      list.forEach(function(s) {
        var tile = document.querySelector('.kiosk-tile[data-user-id="' + s.id + '"]');
        if (!tile) return;
        tile.setAttribute('data-live-status', s.status);
        tile.setAttribute('data-since', s.since || '');
        var badge = tile.querySelector('[data-status]');
        if (badge) {
          badge.className = 'badge kiosk-status-badge kiosk-status-' + s.status;
          badge.textContent = STATUS_LABEL[s.status];
        }
        var avatarEl = tile.querySelector('.kiosk-tile-avatar');
        var currentPath = avatarEl ? (avatarEl.getAttribute('data-path') || '') : '';
        if (currentPath !== (s.avatarPath || '')) {
          updateTileAvatar(s.id, s.avatarPath, tile.getAttribute('data-color'), tile.getAttribute('data-user-name'));
        }
      });
      tickTileTimers();
    }).catch(function() {});
  }
  setInterval(refreshTiles, 30000);

  // Running "clocked in for Xh Ym" / "On break Xh Ym" label under each
  // tile's status badge — reads the since timestamp refreshTiles keeps in
  // sync, so it stays accurate even across a shift change on another device.
  function tickTileTimers() {
    document.querySelectorAll('.kiosk-tile').forEach(function(tile) {
      var timerEl = tile.querySelector('.kiosk-tile-timer');
      if (!timerEl) return;
      var since = tile.getAttribute('data-since');
      var status = tile.getAttribute('data-live-status');
      if (!since || status === 'clocked_out') { timerEl.textContent = ''; return; }
      var ms = Date.now() - new Date(since).getTime();
      if (ms < 0) ms = 0;
      var totalMin = Math.floor(ms / 60000);
      var h = Math.floor(totalMin / 60);
      var m = totalMin % 60;
      var dur = h > 0 ? (h + 'h ' + m + 'm') : (m + 'm');
      timerEl.textContent = (status === 'on_break' ? 'On break ' : 'In ') + dur;
    });
  }
  tickTileTimers();
  setInterval(tickTileTimers, 30000);

  function tickClock() {
    document.getElementById('kioskClock').textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  }
  tickClock();
  setInterval(tickClock, 1000);

  // ---- Bar Staff Duties tab/panel ----
  var dutiesTab = document.getElementById('dutiesTab');
  var dutiesPanel = document.getElementById('dutiesPanel');
  var dutiesPanelBody = document.getElementById('dutiesPanelBody');
  var dutiesPanelFooter = document.getElementById('dutiesPanelFooter');
  var dutiesReasonBox = document.getElementById('dutiesReasonBox');
  var dutiesDoneMsg = document.getElementById('dutiesDoneMsg');
  var dutiesState = null;
  var dutiesPanelOpen = false;

  // After Breakfast Duties and After Carvery Duties ask "who's submitting?"
  // and take a live photo as part of Submit; Opening and Closing keep the
  // plain flow they've always had.
  var PHOTO_REQUIRED_SECTIONS = ['after_breakfast', 'after_carvery'];
  var dutiesWhoBox = document.getElementById('dutiesWhoBox');
  var dutiesWhoSelect = document.getElementById('dutiesWhoSelect');
  var dutiesCameraBox = document.getElementById('dutiesCameraBox');
  var dutiesCameraVideo = document.getElementById('dutiesCameraVideo');
  var dutiesCameraCanvas = document.getElementById('dutiesCameraCanvas');
  var dutiesCameraStatus = document.getElementById('dutiesCameraStatus');
  var dutiesCaptureBtn = document.getElementById('dutiesCaptureBtn');
  var dutiesCameraStream = null;
  var dutiesSubmitterUserId = null, dutiesSubmitterName = null, dutiesPhotoBlob = null;

  function showDutiesStage(stage) {
    dutiesPanelBody.style.display = stage === 'checklist' ? 'block' : 'none';
    dutiesPanelFooter.style.display = stage === 'checklist' ? 'flex' : 'none';
    dutiesWhoBox.style.display = stage === 'who' ? 'block' : 'none';
    dutiesCameraBox.style.display = stage === 'camera' ? 'block' : 'none';
    dutiesReasonBox.style.display = stage === 'reason' ? 'block' : 'none';
    dutiesDoneMsg.style.display = stage === 'done' ? 'block' : 'none';
  }

  function resetDutiesPhotoFlow() {
    dutiesSubmitterUserId = null;
    dutiesSubmitterName = null;
    dutiesPhotoBlob = null;
  }

  function stopDutiesCamera() {
    if (dutiesCameraStream) {
      dutiesCameraStream.getTracks().forEach(function(t) { t.stop(); });
      dutiesCameraStream = null;
    }
  }

  function startDutiesWho() {
    dutiesWhoSelect.innerHTML = '';
    var placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = 'Select your name…';
    dutiesWhoSelect.appendChild(placeholder);
    document.querySelectorAll('.kiosk-tile').forEach(function(tile) {
      var opt = document.createElement('option');
      opt.value = tile.getAttribute('data-user-id');
      opt.textContent = tile.getAttribute('data-user-name');
      dutiesWhoSelect.appendChild(opt);
    });
    dutiesWhoSelect.value = '';
    showDutiesStage('who');
  }

  function startDutiesCamera() {
    showDutiesStage('camera');
    dutiesCameraStatus.textContent = 'Starting camera…';
    dutiesCaptureBtn.disabled = true;
    dutiesCaptureBtn.textContent = 'Take photo';
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      dutiesCameraStatus.textContent = 'Camera not supported on this device/browser.';
      return;
    }
    navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false })
      .then(function(stream) {
        dutiesCameraStream = stream;
        dutiesCameraVideo.srcObject = stream;
        dutiesCameraStatus.textContent = 'Look at the camera, then tap to continue.';
        dutiesCaptureBtn.disabled = false;
      })
      .catch(function(err) {
        dutiesCameraStatus.textContent = 'Could not access the camera: ' + err.message + '.';
      });
  }

  document.getElementById('dutiesWhoCancel').addEventListener('click', function() {
    resetDutiesPhotoFlow();
    showDutiesStage('checklist');
  });

  document.getElementById('dutiesWhoContinue').addEventListener('click', function() {
    var opt = dutiesWhoSelect.selectedOptions[0];
    if (!opt || !opt.value) { dutiesWhoSelect.focus(); return; }
    dutiesSubmitterUserId = opt.value;
    dutiesSubmitterName = opt.textContent;
    startDutiesCamera();
  });

  document.getElementById('dutiesCameraCancel').addEventListener('click', function() {
    stopDutiesCamera();
    resetDutiesPhotoFlow();
    showDutiesStage('checklist');
  });

  dutiesCaptureBtn.addEventListener('click', function() {
    if (!dutiesCameraStream) return;
    dutiesCaptureBtn.disabled = true;
    dutiesCaptureBtn.textContent = 'Saving…';
    dutiesCameraCanvas.width = dutiesCameraVideo.videoWidth || 480;
    dutiesCameraCanvas.height = dutiesCameraVideo.videoHeight || 480;
    dutiesCameraCanvas.getContext('2d').drawImage(dutiesCameraVideo, 0, 0, dutiesCameraCanvas.width, dutiesCameraCanvas.height);
    dutiesCameraCanvas.toBlob(function(blob) {
      dutiesPhotoBlob = blob;
      stopDutiesCamera();
      dutiesCaptureBtn.disabled = false;
      dutiesCaptureBtn.textContent = 'Take photo';
      var hasMissing = dutiesState && dutiesState.tasks.some(function(t) { return !t.done; });
      if (hasMissing) {
        showDutiesStage('reason');
      } else {
        submitDutiesWithPhoto('');
      }
    }, 'image/jpeg', 0.85);
  });

  function submitDutiesWithPhoto(reason) {
    if (!dutiesState || !dutiesPhotoBlob || !dutiesSubmitterUserId) return;
    var formData = new FormData();
    formData.append('date', dutiesState.date);
    formData.append('section', dutiesState.section);
    formData.append('reason', reason || '');
    formData.append('submittedByUserId', dutiesSubmitterUserId);
    formData.append('submittedByName', dutiesSubmitterName || '');
    formData.append('photo', dutiesPhotoBlob, 'duty.jpg');
    fetch('/kiosk/duties/submit', { method: 'POST', body: formData, headers: { Accept: 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' } })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.needsReason) {
          // Shouldn't normally happen (already checked client-side before
          // getting here), but handle it defensively rather than getting stuck.
          showDutiesStage('reason');
          return;
        }
        finishDutiesSubmit();
      })
      .catch(function() {
        dutiesCameraStatus.textContent = 'Could not reach the server — please try again.';
        showDutiesStage('who');
      });
  }

  function finishDutiesSubmit() {
    showDutiesStage('done');
    resetDutiesPhotoFlow();
    setTimeout(function() {
      dutiesPanelOpen = false;
      dutiesPanel.classList.remove('open');
      fetchDutiesStatus();
    }, 1800);
  }

  function renderDutiesTab() {
    if (!dutiesState || !dutiesState.active) {
      dutiesTab.style.display = 'none';
      dutiesPanel.classList.remove('open');
      dutiesPanelOpen = false;
      return;
    }
    dutiesTab.style.display = dutiesPanelOpen ? 'none' : 'flex';
    document.getElementById('dutiesTabTitle').textContent = dutiesState.sectionTitle;
    document.getElementById('dutiesTabCount').textContent = dutiesState.doneCount + '/' + dutiesState.totalCount;
  }

  function renderDutiesPanel() {
    if (!dutiesState) return;
    document.getElementById('dutiesPanelTitle').textContent = dutiesState.sectionTitle;
    dutiesPanelBody.innerHTML = '';
    dutiesState.tasks.forEach(function(t) {
      var row = document.createElement('label');
      row.className = 'kiosk-duty-row' + (t.done ? ' done' : '');
      var cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.checked = t.done;
      cb.addEventListener('change', function() { toggleDuty(t.id); });
      var span = document.createElement('span');
      span.textContent = t.text;
      row.appendChild(cb);
      row.appendChild(span);
      dutiesPanelBody.appendChild(row);
    });
  }

  function fetchDutiesStatus() {
    fetch('/kiosk/duties-status').then(function(r) { return r.json(); }).then(function(data) {
      dutiesState = data;
      if (!data.active) {
        dutiesPanelOpen = false;
        showDutiesStage('checklist');
      } else if (dutiesPanelOpen) {
        renderDutiesPanel();
      }
      renderDutiesTab();
    }).catch(function() {});
  }
  setInterval(fetchDutiesStatus, 30000);
  fetchDutiesStatus();

  function toggleDuty(taskId) {
    if (!dutiesState) return;
    fetch('/kiosk/duties/toggle', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': '<%= csrfToken %>' },
      body: 'date=' + encodeURIComponent(dutiesState.date) + '&taskId=' + encodeURIComponent(taskId)
    }).then(fetchDutiesStatus);
  }

  dutiesTab.addEventListener('click', function() {
    dutiesPanelOpen = true;
    dutiesPanel.classList.add('open');
    showDutiesStage('checklist');
    renderDutiesPanel();
    renderDutiesTab();
  });

  document.getElementById('dutiesCollapseBtn').addEventListener('click', function() {
    stopDutiesCamera();
    dutiesPanelOpen = false;
    dutiesPanel.classList.remove('open');
    renderDutiesTab();
  });

  function submitDuties(reason) {
    if (!dutiesState) return;
    var body = 'date=' + encodeURIComponent(dutiesState.date) + '&section=' + encodeURIComponent(dutiesState.section) + '&reason=' + encodeURIComponent(reason || '');
    fetch('/kiosk/duties/submit', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': '<%= csrfToken %>' }, body: body })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.needsReason) {
          showDutiesStage('reason');
          return;
        }
        finishDutiesSubmit();
      });
  }

  document.getElementById('dutiesSubmitBtn').addEventListener('click', function() {
    if (dutiesState && PHOTO_REQUIRED_SECTIONS.indexOf(dutiesState.section) !== -1) {
      startDutiesWho();
    } else {
      submitDuties('');
    }
  });
  document.getElementById('dutiesReasonCancel').addEventListener('click', function() {
    resetDutiesPhotoFlow();
    showDutiesStage('checklist');
  });
  document.getElementById('dutiesReasonSend').addEventListener('click', function() {
    var reason = document.getElementById('dutiesReasonText').value.trim();
    if (!reason) return;
    if (dutiesPhotoBlob) {
      submitDutiesWithPhoto(reason);
    } else {
      submitDuties(reason);
    }
  });
})();
</script>
</body>
</html>
