<!DOCTYPE html>
<html>
<head>
  <title>Forgot Password - The Holy Cross</title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="login-wrap--brand">
    <div class="login-card--brand">
      <img class="login-logo-full" src="/img/logo-full.png" alt="The Holy Cross - Bar & Restaurant, Since 1775">
      <p class="login-tagline">Reset your password.</p>

      <% if (sent) { %>
        <div class="success-box">If that account exists, we've emailed reset instructions to the address on file. The link expires in 1 hour.</div>
        <a href="/login" class="login-forgot-link">Back to log in</a>
      <% } else { %>
        <p class="muted" style="margin:0 0 18px;font-size:13.5px">Enter your username, phone number, or email, and we'll send a reset link to the email on your account.</p>
        <form method="POST" action="/forgot-password">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field">
            <label>Username, phone, or email</label>
            <div style="display:flex;gap:8px">
              <select name="countryCode" id="forgotCountryCode" style="width:auto;flex:0 0 92px">
                <% countryCodes.forEach(c => { %>
                  <option value="<%= c.code %>" <%= c.code === '+353' ? 'selected' : '' %>><%= c.flag %> <%= c.code %></option>
                <% }) %>
              </select>
              <input type="text" name="identifier" id="forgotIdentifier" required autofocus style="flex:1">
            </div>
          </div>
          <button class="btn" type="submit">Send reset link</button>
          <a href="/login" class="login-forgot-link">Back to log in</a>
        </form>
      <% } %>
    </div>
  </div>

  <script>
    (function() {
      var identifierInput = document.getElementById('forgotIdentifier');
      var countryCodeSelect = document.getElementById('forgotCountryCode');
      if (!identifierInput || !countryCodeSelect) return;
      // Same pattern as the login page — the country-code dropdown only
      // makes sense once someone's clearly typing a phone number, so it
      // stays out of the way while they might be typing a username/email.
      function looksLikePhoneNumber(value) {
        return /^\+?[0-9][0-9\s-]*$/.test(value.trim()) && value.trim().length > 0;
      }
      function updateCountryCodeVisibility() {
        countryCodeSelect.style.display = looksLikePhoneNumber(identifierInput.value) ? 'block' : 'none';
      }
      identifierInput.addEventListener('input', updateCountryCodeVisibility);
      updateCountryCodeVisibility();
    })();
  </script>
</body>
</html>
