<!DOCTYPE html>
<html>
<head>
  <title>My Profile - Booking Admin</title>
  <%- include('partials/head') %>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" rel="stylesheet" onerror="this.remove()">
</head>
<body>
<div class="app-shell">
  <%- include('partials/sidebar') %>
  <div class="main">
    <h2>My Profile</h2>
    <div id="uploadError" class="error-box" style="<%= error ? '' : 'display:none' %>"><%= error || '' %></div>
    <% if (success) { %><div class="badge confirmed" style="padding:8px 14px;margin-bottom:16px;display:inline-block">✓ <%= success %></div><% } %>

    <div class="card" style="max-width:480px">
      <div class="profile-header">
        <% if (profileUser.avatarPath) { %>
          <img class="profile-avatar-lg" id="currentAvatarImg" src="<%= profileUser.avatarPath %>" alt="<%= profileUser.name %>">
        <% } else { %>
          <span class="profile-avatar-lg-placeholder" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Zm0 2c-4.14 0-7.5 2.46-7.5 5.5V21h15v-1.5c0-3.04-3.36-5.5-7.5-5.5Z" fill="currentColor"/></svg>
          </span>
        <% } %>
        <div>
          <div style="font-size:18px;font-weight:700"><%= profileUser.name %></div>
          <div class="muted"><%= profileUser.email %></div>
          <% const roleObj = (roles || []).find(r => r.value === profileUser.role); %>
          <span class="badge confirmed" style="margin-top:6px;display:inline-block">
            <%= roleObj ? roleObj.label : profileUser.role %>
          </span>
        </div>
      </div>

      <form method="POST" action="/profile/avatar" enctype="multipart/form-data" id="avatarForm" style="margin-top:18px">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label>Upload a new profile picture</label>
          <input type="file" name="avatar" id="avatarFileInput" accept="image/jpeg,image/png,image/webp" required>
        </div>
        <p class="muted">JPG, PNG, or WEBP — up to 3MB. Once chosen, drag to reposition and scroll (or use the slider) to zoom.</p>

        <div class="cropper-wrap" id="cropperWrap" style="display:none">
          <div class="cropper-image-box">
            <img id="cropperImage" style="max-width:100%;display:block">
          </div>
          <div class="zoom-row">
            <span class="muted">Zoom</span>
            <input type="range" id="zoomRange" min="0" max="3" step="0.01" value="0">
          </div>
          <div class="actions-row">
            <button class="btn" type="button" id="saveAvatarBtn">Save profile picture</button>
            <button class="btn secondary" type="button" id="cancelCropBtn">Cancel</button>
          </div>
        </div>

        <div class="actions-row" id="plainUploadRow">
          <button class="btn secondary" type="submit" id="plainUploadBtn">Upload without cropping</button>
        </div>
      </form>

      <% if (profileUser.avatarPath) { %>
        <form method="POST" action="/profile/avatar/remove" style="margin-top:10px" onsubmit="return confirm('Remove your profile picture?')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn secondary small" type="submit">Remove current picture</button>
        </form>
      <% } %>
    </div>

    <div class="card" style="max-width:480px">
      <h3 style="margin-top:0">Your information</h3>
      <dl class="detail-grid">
        <dt>Full name</dt><dd><%= profileUser.name %></dd>
        <dt>Username</dt><dd><%= profileUser.username || '—' %></dd>
        <dt>Email</dt><dd><%= profileUser.email || '—' %></dd>
        <dt>Phone</dt><dd><%= profileUser.phone || '—' %></dd>
        <dt>Role</dt><dd><%= roleObj ? roleObj.label : profileUser.role %></dd>
        <dt>Date of birth</dt><dd><%= profileUser.dob || '—' %></dd>
        <dt>Sex</dt><dd><%= profileUser.sex ? (profileUser.sex.charAt(0).toUpperCase() + profileUser.sex.slice(1)) : '—' %></dd>
        <dt>Location</dt><dd><%= profileUser.location || '—' %></dd>
      </dl>
      <p class="muted" style="margin-top:2px">Spotted something wrong here? Ask a manager to update it from the Users page.</p>
    </div>

    <div class="card" style="max-width:640px">
      <h3 style="margin-top:0">This week</h3>
      <p class="muted" style="margin-top:0">Hours worked, Monday to Sunday — a day with no clock-in shows as Off.</p>
      <div class="week-hours-grid">
        <% weekDays.forEach(d => { %>
          <div class="week-hours-day<%= d.isToday ? ' is-today' : '' %>">
            <div class="wh-name"><%= d.dayName.slice(0, 3) %></div>
            <div class="wh-date"><%= d.shortDate %></div>
            <div class="wh-hours<%= d.minutes <= 0 ? ' is-off' : '' %>"><%= d.label %></div>
          </div>
        <% }) %>
      </div>
    </div>

    <% if (profileUser.role !== 'kiosk') { %>
    <div class="card" style="max-width:480px">
      <h3 style="margin-top:0">Security</h3>
      <p class="muted" style="margin-top:0">Change your login password or your kiosk clock-in PIN. Both need a code we email to <%= profileUser.email || 'your account email' %> first.</p>
      <div class="actions-row">
        <button type="button" class="btn secondary" id="openPasswordModalBtn">Change password</button>
        <button type="button" class="btn secondary" id="openPinModalBtn">Change PIN</button>
      </div>
    </div>
    <% } %>
  </div>
</div>

<!-- ---- Change password modal ---- -->
<div class="modal-overlay" id="passwordModal">
  <div class="modal-box">
    <div class="modal-step active" id="passwordStep1">
      <h3>Change password</h3>
      <p class="modal-note">We'll email a 6-digit verification code to the address on file for your account.</p>
      <div id="passwordStep1Error" class="error-box" style="display:none"></div>
      <div class="actions-row">
        <button type="button" class="btn" id="sendPasswordCodeBtn">Send code to my email</button>
        <button type="button" class="btn secondary" id="cancelPasswordModal1">Cancel</button>
      </div>
    </div>
    <div class="modal-step" id="passwordStep2">
      <h3>Enter code &amp; new password</h3>
      <p class="modal-note" id="passwordSentNote">Code sent — check your email. It expires in 10 minutes.</p>
      <div id="passwordStep2Error" class="error-box" style="display:none"></div>
      <div class="field">
        <label>Verification code</label>
        <input type="text" id="passwordCodeInput" inputmode="numeric" pattern="\d{6}" maxlength="6" placeholder="123456">
      </div>
      <div class="field">
        <label>New password</label>
        <input type="password" id="newPasswordInput" autocomplete="new-password">
      </div>
      <div class="field">
        <label>Confirm new password</label>
        <input type="password" id="confirmPasswordInput" autocomplete="new-password">
      </div>
      <p class="muted" style="margin-top:-6px;margin-bottom:14px">Password must be 8-16 characters and include at least one uppercase letter, one lowercase letter, and one special character.</p>
      <div class="actions-row">
        <button type="button" class="btn" id="confirmPasswordBtn">Change password</button>
        <button type="button" class="btn secondary" id="resendPasswordCodeBtn">Resend code</button>
        <button type="button" class="btn secondary" id="cancelPasswordModal2">Cancel</button>
      </div>
    </div>
    <div class="modal-step" id="passwordStepDone">
      <h3>Password changed</h3>
      <p class="modal-note">Your password has been updated. Use it next time you log in.</p>
      <div class="actions-row">
        <button type="button" class="btn" id="closePasswordModalDone">Done</button>
      </div>
    </div>
  </div>
</div>

<!-- ---- Change PIN modal ---- -->
<div class="modal-overlay" id="pinModal">
  <div class="modal-box">
    <div class="modal-step active" id="pinStep1">
      <h3>Change kiosk PIN</h3>
      <p class="modal-note">We'll email a 6-digit verification code to the address on file for your account.</p>
      <div id="pinStep1Error" class="error-box" style="display:none"></div>
      <div class="actions-row">
        <button type="button" class="btn" id="sendPinCodeBtn">Send code to my email</button>
        <button type="button" class="btn secondary" id="cancelPinModal1">Cancel</button>
      </div>
    </div>
    <div class="modal-step" id="pinStep2">
      <h3>Enter code &amp; new PIN</h3>
      <p class="modal-note" id="pinSentNote">Code sent — check your email. It expires in 10 minutes.</p>
      <div id="pinStep2Error" class="error-box" style="display:none"></div>
      <div class="field">
        <label>Verification code</label>
        <input type="text" id="pinCodeInput" inputmode="numeric" pattern="\d{6}" maxlength="6" placeholder="123456">
      </div>
      <div class="field">
        <label>New PIN</label>
        <input type="text" id="newPinInput" inputmode="numeric" pattern="\d{4}" maxlength="4" placeholder="1234">
      </div>
      <div class="field">
        <label>Confirm new PIN</label>
        <input type="text" id="confirmPinInput" inputmode="numeric" pattern="\d{4}" maxlength="4" placeholder="1234">
      </div>
      <div class="actions-row">
        <button type="button" class="btn" id="confirmPinBtn">Change PIN</button>
        <button type="button" class="btn secondary" id="resendPinCodeBtn">Resend code</button>
        <button type="button" class="btn secondary" id="cancelPinModal2">Cancel</button>
      </div>
    </div>
    <div class="modal-step" id="pinStepDone">
      <h3>PIN changed</h3>
      <p class="modal-note">Your kiosk clock-in PIN has been updated.</p>
      <div class="actions-row">
        <button type="button" class="btn" id="closePinModalDone">Done</button>
      </div>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
<script>
  (function() {
    var fileInput = document.getElementById('avatarFileInput');
    var cropperWrap = document.getElementById('cropperWrap');
    var cropperImage = document.getElementById('cropperImage');
    var zoomRange = document.getElementById('zoomRange');
    var saveBtn = document.getElementById('saveAvatarBtn');
    var cancelBtn = document.getElementById('cancelCropBtn');
    var plainUploadRow = document.getElementById('plainUploadRow');
    var errorBox = document.getElementById('uploadError');
    var avatarForm = document.getElementById('avatarForm');
    var cropper = null;

    // Multipart forms can't rely on the hidden _csrf field alone — the CSRF
    // check runs before multer parses a multipart body, so req.body._csrf is
    // never populated in time for a plain browser form submission. This
    // catches the "Upload without cropping" fallback button (and any native
    // submit if CropperJS below fails to load) and resubmits it via fetch
    // with the token as a header instead — registered before the Cropper
    // early-return below so it's wired up either way.
    if (avatarForm) {
      avatarForm.addEventListener('submit', function(e) {
        e.preventDefault();
        var fd = new FormData(avatarForm);
        fetch(avatarForm.action, {
          method: 'POST',
          body: fd,
          headers: { 'X-CSRF-Token': '<%= csrfToken %>' }
        }).then(function(res) { return res.text(); })
          .then(function(html) {
            document.open();
            document.write(html);
            document.close();
          })
          .catch(function() {
            alert('Something went wrong uploading this — please try again.');
          });
      });
    }

    // If the CropperJS CDN script failed to load, the crop UI below never
    // gets wired up — the submit handler above still covers a plain upload.
    if (typeof Cropper === 'undefined') return;

    function showError(message) {
      errorBox.textContent = message;
      errorBox.style.display = 'block';
    }
    function hideError() {
      errorBox.style.display = 'none';
    }

    fileInput.addEventListener('change', function(e) {
      var file = e.target.files[0];
      if (!file) return;
      hideError();
      var reader = new FileReader();
      reader.onload = function(ev) {
        cropperImage.src = ev.target.result;
        cropperWrap.style.display = 'block';
        plainUploadRow.style.display = 'none';
        if (cropper) cropper.destroy();
        cropper = new Cropper(cropperImage, {
          aspectRatio: 1,
          viewMode: 1,
          dragMode: 'move',
          background: false,
          autoCropArea: 1,
          cropBoxResizable: false,
          cropBoxMovable: false,
          zoomOnWheel: true,
          ready: function() { zoomRange.value = 0; }
        });
      };
      reader.readAsDataURL(file);
    });

    zoomRange.addEventListener('input', function() {
      if (cropper) cropper.zoomTo(Number(zoomRange.value));
    });

    cancelBtn.addEventListener('click', function() {
      if (cropper) { cropper.destroy(); cropper = null; }
      cropperWrap.style.display = 'none';
      plainUploadRow.style.display = 'flex';
      fileInput.value = '';
      hideError();
    });

    saveBtn.addEventListener('click', function() {
      if (!cropper) return;
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving...';
      cropper.getCroppedCanvas({ width: 480, height: 480, imageSmoothingQuality: 'high' }).toBlob(function(blob) {
        var formData = new FormData();
        formData.append('avatar', blob, 'avatar.jpg');
        fetch('/profile/avatar', {
          method: 'POST',
          body: formData,
          headers: { 'Accept': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' }
        })
          .then(function(res) {
            return res.json().then(function(data) { return { ok: res.ok, data: data }; });
          })
          .then(function(result) {
            if (!result.ok) {
              showError((result.data && result.data.error) || 'Upload failed. Please try again.');
              saveBtn.disabled = false;
              saveBtn.textContent = 'Save profile picture';
              return;
            }
            window.location.reload();
          })
          .catch(function() {
            showError('Upload failed. Please check your connection and try again.');
            saveBtn.disabled = false;
            saveBtn.textContent = 'Save profile picture';
          });
      }, 'image/jpeg', 0.92);
    });
  })();
</script>

<script>
(function() {
  var CSRF = '<%= csrfToken %>';

  // Shared plumbing for the two "send code -> enter code + new value" modals
  // (Change password / Change PIN) — same two-step shape, just different
  // endpoints and fields, so one small factory wires both up instead of
  // duplicating the fetch/step-switching logic twice.
  function setupChangeModal(opts) {
    var overlay = document.getElementById(opts.modalId);
    var openBtn = document.getElementById(opts.openBtnId);
    var step1 = document.getElementById(opts.step1Id);
    var step2 = document.getElementById(opts.step2Id);
    var stepDone = document.getElementById(opts.stepDoneId);
    var err1 = document.getElementById(opts.err1Id);
    var err2 = document.getElementById(opts.err2Id);
    var sentNote = document.getElementById(opts.sentNoteId);
    if (!overlay || !openBtn) return;

    function showStep(step) {
      [step1, step2, stepDone].forEach(function(s) { s.classList.remove('active'); });
      step.classList.add('active');
    }
    function showError(box, message) {
      box.textContent = message;
      box.style.display = 'block';
    }
    function hideError(box) {
      box.style.display = 'none';
    }
    function open() {
      overlay.classList.add('open');
      showStep(step1);
      hideError(err1);
      hideError(err2);
    }
    function close() {
      overlay.classList.remove('open');
      opts.fields.forEach(function(id) { var el = document.getElementById(id); if (el) el.value = ''; });
    }

    function sendCode(fromBtn) {
      fromBtn.disabled = true;
      var originalText = fromBtn.textContent;
      fromBtn.textContent = 'Sending...';
      fetch(opts.sendCodeUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF }
      })
        .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, data: data }; }); })
        .then(function(result) {
          fromBtn.disabled = false;
          fromBtn.textContent = originalText;
          if (!result.ok) {
            showError(err1, (result.data && result.data.error) || 'Could not send a code. Please try again.');
            return;
          }
          sentNote.textContent = 'Code sent to ' + (result.data.maskedEmail || 'your email') + ' — check your inbox. It expires in 10 minutes.';
          hideError(err2);
          showStep(step2);
        })
        .catch(function() {
          fromBtn.disabled = false;
          fromBtn.textContent = originalText;
          showError(err1, 'Something went wrong sending the code. Please check your connection and try again.');
        });
    }

    openBtn.addEventListener('click', open);
    document.getElementById(opts.cancel1Id).addEventListener('click', close);
    document.getElementById(opts.cancel2Id).addEventListener('click', close);
    document.getElementById(opts.closeDoneId).addEventListener('click', function() {
      close();
      window.location.reload();
    });
    document.getElementById(opts.sendBtnId).addEventListener('click', function() { sendCode(this); });
    document.getElementById(opts.resendBtnId).addEventListener('click', function() { sendCode(this); });

    document.getElementById(opts.confirmBtnId).addEventListener('click', function() {
      var btn = this;
      var body = opts.buildBody();
      if (opts.validate) {
        var validationError = opts.validate(body);
        if (validationError) { showError(err2, validationError); return; }
      }
      btn.disabled = true;
      var originalText = btn.textContent;
      btn.textContent = 'Saving...';
      fetch(opts.confirmUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
        body: JSON.stringify(body)
      })
        .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, data: data }; }); })
        .then(function(result) {
          btn.disabled = false;
          btn.textContent = originalText;
          if (!result.ok) {
            showError(err2, (result.data && result.data.error) || 'Something went wrong. Please try again.');
            return;
          }
          showStep(stepDone);
        })
        .catch(function() {
          btn.disabled = false;
          btn.textContent = originalText;
          showError(err2, 'Something went wrong. Please check your connection and try again.');
        });
    });
  }

  setupChangeModal({
    modalId: 'passwordModal', openBtnId: 'openPasswordModalBtn',
    step1Id: 'passwordStep1', step2Id: 'passwordStep2', stepDoneId: 'passwordStepDone',
    err1Id: 'passwordStep1Error', err2Id: 'passwordStep2Error', sentNoteId: 'passwordSentNote',
    cancel1Id: 'cancelPasswordModal1', cancel2Id: 'cancelPasswordModal2', closeDoneId: 'closePasswordModalDone',
    sendBtnId: 'sendPasswordCodeBtn', resendBtnId: 'resendPasswordCodeBtn', confirmBtnId: 'confirmPasswordBtn',
    sendCodeUrl: '/profile/password/send-code', confirmUrl: '/profile/password/confirm',
    fields: ['passwordCodeInput', 'newPasswordInput', 'confirmPasswordInput'],
    buildBody: function() {
      return {
        code: document.getElementById('passwordCodeInput').value.trim(),
        password: document.getElementById('newPasswordInput').value,
        confirmPassword: document.getElementById('confirmPasswordInput').value
      };
    },
    validate: function(body) {
      if (!body.code || body.code.length !== 6) return 'Enter the 6-digit code from your email.';
      if (!body.password || !body.confirmPassword) return 'Enter and confirm your new password.';
      if (body.password !== body.confirmPassword) return 'Passwords do not match.';
      return null;
    }
  });

  setupChangeModal({
    modalId: 'pinModal', openBtnId: 'openPinModalBtn',
    step1Id: 'pinStep1', step2Id: 'pinStep2', stepDoneId: 'pinStepDone',
    err1Id: 'pinStep1Error', err2Id: 'pinStep2Error', sentNoteId: 'pinSentNote',
    cancel1Id: 'cancelPinModal1', cancel2Id: 'cancelPinModal2', closeDoneId: 'closePinModalDone',
    sendBtnId: 'sendPinCodeBtn', resendBtnId: 'resendPinCodeBtn', confirmBtnId: 'confirmPinBtn',
    sendCodeUrl: '/profile/pin/send-code', confirmUrl: '/profile/pin/confirm',
    fields: ['pinCodeInput', 'newPinInput', 'confirmPinInput'],
    buildBody: function() {
      return {
        code: document.getElementById('pinCodeInput').value.trim(),
        pin: document.getElementById('newPinInput').value,
        confirmPin: document.getElementById('confirmPinInput').value
      };
    },
    validate: function(body) {
      if (!body.code || body.code.length !== 6) return 'Enter the 6-digit code from your email.';
      if (!/^\d{4}$/.test(body.pin || '')) return 'PIN must be exactly 4 digits.';
      if (body.pin !== body.confirmPin) return 'PINs do not match.';
      return null;
    }
  });
})();
</script>
</body>
</html>
