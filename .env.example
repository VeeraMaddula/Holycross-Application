# Copy this file to .env and fill in your own values.

# Port the app runs on
PORT=3000

# Used ONLY the very first time the app starts, to create the initial admin account.
# After that, manage logins from the Users page in the app instead of these values.
ADMIN_EMAIL=admin@holycross.local
ADMIN_PASSWORD=changeme123

# Random string used to sign login sessions (any long random text is fine)
SESSION_SECRET=please-change-this-to-something-random

# --- Email (optional, needed for confirmation/reminder/cancellation emails) ---
# Using Resend (recommended — Gmail App Passwords aren't available on every
# Google account anymore). Sign up free at https://resend.com, verify a domain
# under Domains, then use these SMTP settings with your Resend API key as the
# password. See README for full setup steps.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=your-resend-api-key
SMTP_FROM=bookings@your-verified-domain.com

# Optional: use a different "from" mailbox for specific notification
# categories, so staff can tell at a glance what an email is about. Each is
# optional — leave any of these blank and that category just falls back to
# SMTP_FROM above. No separate mailbox setup needed on the Resend side;
# these just need to be addresses at the same domain you already verified
# for SMTP_FROM (Resend authenticates the whole domain, not one address).
SMTP_FROM_SHIFTS=shifts@your-verified-domain.com
SMTP_FROM_REQUESTS=requests@your-verified-domain.com
SMTP_FROM_REPORTS=reports@your-verified-domain.com

# Optional: send a copy of every new booking to this address
ADMIN_NOTIFICATION_EMAIL=owner@example.com

# --- SMS (optional, needed for confirmation/reminder/cancellation texts) ---
# Using Sendmode's Engage API (an Irish SMS provider, sms-rest.sendmode.dev
# 3.0 — NOT rest.sendmode.com/v2, which is a legacy system that silently
# accepts requests without ever delivering them). Sign up free at
# https://app.sendmode.com/createaccount, then under Bulk SMS APIs >
# Create API Key generate an API Access Key and paste it below. See README
# "SMS via Sendmode" for the full one-time setup.
SENDMODE_API_KEY=your-sendmode-access-key
# The "from" name shown to customers on every text (falls back to
# "HolyCross" in code if left blank). IMPORTANT: an unregistered/
# unapproved alpha sender ID isn't just "possibly rejected" — it gets
# silently rejected with no error surfaced to the app, so you'll never
# know unless you check Sendmode's own Sent SMS report. Register the real
# one via your Sendmode dashboard (goes through ComReg, usually ~5 days
# once actually submitted — confirm with Sendmode support that it's been
# submitted, don't just assume) BEFORE relying on this for real customer
# texts.
SENDMODE_SENDER_ID=HolyCross

# --- Google Calendar sync (optional) ---
# See README for the one-time Google Cloud Console setup steps.
# Path to the service account JSON key file you download from Google Cloud Console.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json
# The calendar you shared with the service account's email address (its "Calendar ID",
# found in that calendar's Settings > Integrate calendar — looks like an email address).
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
# Timezone used when creating events (optional, defaults to Europe/Dublin)
APP_TIMEZONE=Europe/Dublin
